{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Osnova problem",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "topic",
    "level",
    "minutes",
    "tags",
    "statement",
    "materials",
    "solution",
    "mistakes",
    "theory",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "basic",
        "school",
        "advanced",
        "challenge"
      ]
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "statement": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "solution": {
      "type": "object",
      "required": [
        "steps",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string"
        }
      }
    },
    "mistakes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "theory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "string"
    }
  }
}
